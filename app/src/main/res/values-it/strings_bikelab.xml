    <string name="bikelab_lamps_hint">Ogni canale è solo acceso o spento. Una luce spenta dall’app resta spenta finché un vero cambio di stato o questo ripristino non la riaccende.</string>

    <string name="bikelab_boost">Boost in movimento</string>
    <string name="bikelab_boost_caption">Tenere premuto Boost cambia il livello anche in movimento, non solo da fermo.</string>

    <string name="bikelab_actions_title">Da fermo</string>
    <string name="bikelab_sleep">Metti a riposo</string>
    <string name="bikelab_alarm_stop">Ferma l’allarme</string>
    <string name="bikelab_alarm_stop_note">Ferma un allarme in corso senza il codice di backup. Il comando cancella anche il blocco software; la bici può poi risultare sbloccata.</string>
    <string name="bikelab_selftest">Avvia l’autotest</string>
    <string name="bikelab_selftest_hint">La bici suona il tono di diagnosi, scrive il suo stato nel registro e poi va in standby. Il registro viene salvato prima.</string>
    <string name="bikelab_selftest_archiving">Salvataggio del registro …</string>
    <string name="bikelab_selftest_dialog_title">Avvia l’autotest</string>
    <string name="bikelab_selftest_dialog_text">La bici salva prima il suo registro, poi esegue la diagnosi e va in standby. Il rapporto spinge fuori le righe più vecchie; per questo si salva prima.</string>
