    <string name="bikelab_title">Bike-Lab</string>
    <string name="bikelab_intro">Valori che il firmware conosce e che nessuna app mostra, con i comandi che funzionano solo da fermo.</string>
    <string name="bikelab_needs_link">La bici non è connessa. I valori restano vuoti finché il collegamento non è attivo.</string>

