    <string name="bikelab_siren_stop">Сигнализация выключена</string>
    <string name="bikelab_siren_active">Сирена работает (уровень\u00A0%1$d).</string>
    <string name="bikelab_siren_dialog_title">Включить сирену уровня\u00A0%1$d</string>
    <string name="bikelab_siren_dialog_confirm">Включить</string>
</resources>
