<!-- Sound-Lab на экране «Звук» (ui/components/SoundLabBits.kt): громкость каждого звука (5572) и пять заменяемых звуков. -->
<resources>
    <!-- Громкость каждого звука -->
    <string name="soundlab_tiers_title">Громкость каждого звука</string>
    <string name="soundlab_tiers_hint">Каждый звук играет на уровне\u00A020, 30 или 38 либо не играет вовсе. Три уровня задаёт прошивка; здесь ты выбираешь, какой звук получает какой.</string>
    <string name="soundlab_tiers_unread">Велосипед ещё не сообщил свои громкости. До тех пор лесенки показывают заводскую настройку начиная с прошивки\u00A01.9.1.</string>
    <string name="soundlab_tiers_read">Считать с велосипеда</string>
    <string name="soundlab_tiers_reading">Чтение…</string>
    <string name="soundlab_tiers_none">Велосипед не сообщает громкости. Вероятно, его прошивка не предлагает это значение.</string>
    <string name="soundlab_tiers_offline">Пожалуйста, подключись к велосипеду, чтобы считать и сохранить громкости.</string>
    <string name="soundlab_tier_off">выкл</string>
    <string name="soundlab_tier_silent">Без звука</string>
    <string name="soundlab_tier_low">Тихо</string>
    <string name="soundlab_tier_medium">Средне</string>
    <string name="soundlab_tier_high">Громко</string>
    <string name="soundlab_tier_level">%1$s, уровень\u00A0%2$d</string>
    <string name="soundlab_tier_changed">%1$s вместо %2$s</string>
