    <!-- Bike screen: about -->
    <string name="bike_about_title">About</string>
    <!-- matrix: ASCII A-Z 0-9 only, max 7 chars -->
    <string name="bike_about_matrix">YABA</string>
    <string name="bike_about_name">YABA</string>
    <string name="bike_about_version">Yet Another Bike App, version\u00A0%1$s</string>
    <string name="bike_about_slogan">Keeps riding. No matter what.</string>
    <string name="bike_about_disclaimer">For VanMoof S3, X3, S2 and X2. Not affiliated with VanMoof and not an official VanMoof app.</string>
    <string name="bike_about_credits">YABA rests on the open work of mooovy (mjarkk), VanMoofKit (SvenTiigi), pymoof (quantsini) and on Knight1’s decompilation of the S3 firmware. Many thanks for that. Thanks also to everyone who designed and built the S3.</string>

