    <string name="bike_code_clear_text">Without a backup code, only your phone can unlock the bike. Deleting the code also turns off the alarm of the bike.</string>

    <!-- Bike screen: experiments -->
    <string name="bike_exp_title">Experiments</string>
    <string name="bike_exp_intro">Since firmware\u00A01.8.2, the bike no longer accepts 37\u00A0km/h or level\u00A05 over Bluetooth, and firmware\u00A01.9.3 does not either. The firmware resets both on startup. Only a modified firmware could bring them back, and this app does not include one.</string>
    <string name="bike_exp_fw">Your bike runs firmware\u00A0%1$s.</string>
    <string name="bike_exp_fw_knows_37">This version still supports 37\u00A0km/h.</string>
