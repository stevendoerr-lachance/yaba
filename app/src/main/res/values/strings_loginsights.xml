    <string name="loginsights_wake_none_found">The saved log contains no wake line.</string>
    <string name="loginsights_wake_more">Show more days</string>
    <string name="loginsights_wake_caveat">A wake line only reaches the memory if the bike stays awake for about a minute afterwards. Times follow the bike’s clock.</string>

    <!-- Log seek -->
    <string name="loginsights_seek_title">Read only new lines</string>
    <string name="loginsights_seek_intro">Moves the bike’s read pointer past the newest saved line. YABA then reads only new lines, which is faster.</string>
    <string name="loginsights_seek_warning">This cannot be undone. The bike will no longer hand older lines to any app or workshop; they remain only on this phone.</string>
    <string name="loginsights_seek_check_link">Bike connected</string>
    <string name="loginsights_seek_check_complete">Log read to the end</string>
    <string name="loginsights_seek_check_complete_hint">Please read the log completely, here or in Diagnostics.</string>
    <string name="loginsights_seek_check_saved">Download saved on the phone</string>
    <string name="loginsights_seek_check_saved_hint">The file of the last download is in YABA’s storage and matches character for character.</string>
    <string name="loginsights_seek_check_fresh">Age of the download</string>
    <string name="loginsights_seek_check_fresh_hint">At most %d\u00A0minutes old and from the current connection, so no new line is skipped.</string>
    <string name="loginsights_seek_check_newest">Newest saved line</string>
    <string name="loginsights_seek_check_newest_hint">The pointer moves to just before this time on the bike’s clock, never by phone time.</string>
    <string name="loginsights_seek_check_clock_hint">The bike’s clock is not set. Please set it first; otherwise the newest line is ambiguous.</string>
    <string name="loginsights_seek_button">Move pointer to %s</string>
    <string name="loginsights_seek_button_plain">Move pointer</string>
    <string name="loginsights_seek_busy">Moving the pointer …</string>
    <string name="loginsights_seek_blocked">Possible once every point above is met.</string>
    <string name="loginsights_seek_confirm_title">Move read pointer</string>
    <string name="loginsights_seek_confirm_text">The bike will then hand out only lines from %1$s on %2$s onward. The %3$s lines before that will exist only on this phone.</string>
    <string name="loginsights_seek_confirm">Move</string>
    <string name="loginsights_seek_cancel">Cancel</string>
    <string name="loginsights_seek_done">The pointer is now before %s. The next read returns only new lines.</string>
    <string name="loginsights_archive_read_where">New lines come in once you read the log in Diagnostics under “Bike log”.</string>
