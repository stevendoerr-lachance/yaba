    <string name="loginsights_chart_temps">Temperatures in °C</string>
    <string name="loginsights_chart_battery_note" formatted="false">Below the line at 22% the firmware allows the motor less current. The module battery is the small cell in the electronics module, not the main battery.</string>
    <string name="loginsights_chart_current_no_limit">The saved log holds no current limit for this ride. The bike writes it only when it changes.</string>
    <string name="loginsights_chart_cd">%1$s, %2$s to %3$s. Lowest value %4$s, highest value %5$s.</string>
