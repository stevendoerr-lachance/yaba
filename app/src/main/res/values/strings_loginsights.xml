    <string name="loginsights_series_main_battery">Main battery</string>
    <string name="loginsights_series_module_battery">Module battery</string>
    <string name="loginsights_series_motor_current">Motor current</string>
    <string name="loginsights_series_limit">Firmware limit</string>
    <string name="loginsights_series_temp_battery">Battery</string>
    <string name="loginsights_series_temp_motor">Motor</string>
    <string name="loginsights_series_temp_driver">Controller</string>
    <string name="loginsights_series_shift_retry">Shift retry</string>
