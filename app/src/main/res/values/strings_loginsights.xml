    <string name="loginsights_col_motortemp">Motor °C</string>

    <!-- Derate explainer -->
    <string name="loginsights_derate_title">Current limiting</string>
    <string name="loginsights_derate_intro">The firmware sets how much current the motor may draw from the battery charge and the battery temperature. The bike does not report this value over Bluetooth, but the log records every change.</string>
    <string name="loginsights_derate_of_max">of at most %s</string>
    <string name="loginsights_derate_full">At %1$s battery and %2$s, the motor may draw the full %3$s.</string>
    <string name="loginsights_derate_empty">At %1$s battery, the firmware allows no current, so the motor does not assist.</string>
    <string name="loginsights_derate_battery">At %1$s battery, the firmware allows only %2$s instead of %3$s.</string>
    <string name="loginsights_derate_next_soc">From %1$s battery, it is %2$s.</string>
    <string name="loginsights_derate_cold">At a battery temperature of %1$s, the firmware allows only %2$s instead of %3$s.</string>
    <string name="loginsights_derate_next_warmer">Above %1$s, it is %2$s.</string>
    <string name="loginsights_derate_heat">At a battery temperature of %1$s, the firmware allows only %2$s instead of %3$s.</string>
    <string name="loginsights_derate_next_cooler">Up to %1$s, it is %2$s again.</string>
    <string name="loginsights_derate_both">At %1$s battery and a battery temperature of %2$s, the firmware allows only %3$s instead of %4$s. Both limit it.</string>
    <string name="loginsights_derate_unknown">Battery charge or battery temperature is missing. Read the log, and YABA uses the temperature from the last measurement line.</string>
    <string name="loginsights_derate_basis_live">Battery charge directly from the bike, battery temperature from the measurement line at %s. The temperature is logged only every 30\u00A0seconds, so this is approximate.</string>
    <string name="loginsights_derate_basis_log">Battery charge and temperature from the measurement line at %s. With the bike connected, YABA uses the current charge.</string>
    <string name="loginsights_derate_grid_title">Current limit by charge and temperature</string>
    <string name="loginsights_derate_grid_cd">Table of current limits: rows by battery temperature, columns by battery charge.</string>
    <string name="loginsights_derate_now">current state</string>
    <string name="loginsights_derate_grid_note">The table comes from firmware\u00A01.07.06 and was checked line by line. On 1.9.3 it is probably the same.</string>
    <string name="loginsights_derate_log_title">Changes in the log</string>
    <string name="loginsights_derate_log_row">%1$s at %2$s battery</string>
    <string name="loginsights_derate_log_row_nosoc">%1$s, battery charge unknown</string>
    <string name="loginsights_derate_log_none">The saved log contains no change of the current limit.</string>

    <!-- Shifter health -->
    <string name="loginsights_shift_title">Shifting</string>
    <string name="loginsights_shift_intro">The log records every shift retry, every position error, the shifter switching off, and its zero-point calibration.</string>
    <string name="loginsights_shift_summary_ok">In %s of riding, the shifter worked without a retry or a position error.</string>
    <plurals name="loginsights_shift_summary_retries">
        <item quantity="one">In %1$s of riding, the shifter had to retry %2$d time.</item>
        <item quantity="other">In %1$s of riding, the shifter had to retry %2$d times.</item>
    </plurals>
    <plurals name="loginsights_shift_summary_position">
        <item quantity="one">The shifter lost its position %d time. Please have the shifting checked.</item>
        <item quantity="other">The shifter lost its position %d times. Please have the shifting checked.</item>
    </plurals>
    <string name="loginsights_shift_retries">Shift retries</string>
    <string name="loginsights_shift_retries_hint">A gear did not engage on the first attempt.</string>
    <string name="loginsights_shift_per_hour">%s per riding hour</string>
    <string name="loginsights_shift_position">Position errors</string>
    <string name="loginsights_shift_position_hint">The shifter could not find its position.</string>
    <string name="loginsights_shift_off">Shifter switched off</string>
    <string name="loginsights_shift_off_hint">Usually the normal switch-off after a rest.</string>
    <string name="loginsights_shift_zero">Zero-point calibrations</string>
    <string name="loginsights_shift_zero_hint">The shifter looks for its zero point, usually after power-on.</string>
    <string name="loginsights_shift_by_gear">Retries by gear</string>
    <string name="loginsights_shift_gear">Gear\u00A0%d</string>
    <string name="loginsights_shift_by_gear_cd">Retries by gear. Gear\u00A01: %1$d, gear\u00A02: %2$d, gear\u00A03: %3$d, gear\u00A04: %4$d.</string>
    <string name="loginsights_shift_events">Entries</string>
    <string name="loginsights_shift_event_retry">Gear\u00A0%1$s, reported %2$s, retried</string>
    <string name="loginsights_shift_event_position">Position error</string>
    <string name="loginsights_shift_event_off">Shifter switched off</string>
    <string name="loginsights_shift_event_zero">Zero point calibrated</string>
    <string name="loginsights_shift_event_speed">at %s</string>
    <string name="loginsights_shift_event_parked">at a standstill</string>
    <string name="loginsights_shift_none">The saved log contains no shifter entry.</string>
    <string name="loginsights_shift_caveat">The messages come from firmware\u00A01.07.06. Your Revotronics shifter may report differently, so check the lines against a log from your bike.</string>

    <!-- Wake timeline -->
    <string name="loginsights_wake_title">Wake log</string>
    <string name="loginsights_wake_intro">The log records why the bike woke up. A shake without a ride afterwards usually means someone moved the bike.</string>
    <string name="loginsights_wake_clock_skew">The bike’s clock differs from phone time by %s. Please set the bike’s clock, and the times will match.</string>
    <string name="loginsights_wake_legend_ride">Ride</string>
    <string name="loginsights_wake_legend_wake">Woke up</string>
    <string name="loginsights_wake_legend_moved">Shake without a ride</string>
    <string name="loginsights_wake_day_cd">%1$s. Rides: %2$d. Wake-ups: %3$d. Moved without a ride: %4$d.</string>
    <string name="loginsights_wake_none">No reason reported</string>
    <string name="loginsights_wake_rtc">Bike wake timer</string>
