<!-- Tachograph / Fahrtenschreiber (ui/screens/LogInsightsScreen.kt). English is the default. -->
<resources>
    <string name="loginsights_title">Tachograph</string>
    <string name="loginsights_close">Close</string>
    <string name="loginsights_intro">The bike writes a measurement line to its log every 30\u00A0seconds while it is awake. YABA turns it into charts per ride, including rides without the phone.</string>
    <string name="loginsights_loading">Reading the saved log …</string>
    <string name="loginsights_more">Show more</string>
    <string name="loginsights_yes">yes</string>
    <string name="loginsights_no">no</string>

    <!-- Formats (java.time patterns) and units. U+00A0 between number and unit, none before %. -->
    <string name="loginsights_fmt_time">h:mm a</string>
    <string name="loginsights_fmt_time_seconds">h:mm:ss a</string>
    <string name="loginsights_fmt_ride">EEE, MMM d, h:mm a</string>
    <string name="loginsights_fmt_day">EEEE, MMM d, yyyy</string>
    <string name="loginsights_fmt_day_short">EEE M/d</string>
    <string name="loginsights_fmt_date">MMM d, yyyy</string>
    <string name="loginsights_at_time">%s</string>
    <string name="loginsights_unit_kmh">%s\u00A0km/h</string>
    <string name="loginsights_unit_km">%s\u00A0km</string>
    <string name="loginsights_unit_pct">%s%%</string>
    <string name="loginsights_unit_amp">%s\u00A0A</string>
    <string name="loginsights_unit_celsius">%s\u00A0°C</string>
    <string name="loginsights_unit_min">%d\u00A0min</string>
    <string name="loginsights_unit_h_min">%1$d\u00A0h %2$d\u00A0min</string>

    <!-- Entry in Diagnostics -->
    <string name="loginsights_entry_intro">The tachograph shows rides, current limiting, shifting, and wake-ups from the bike’s own log.</string>
    <string name="loginsights_entry_empty">No log is saved on this phone yet. Read the bike log once, and the rides appear here.</string>
    <string name="loginsights_entry_no_rides">The saved log does not contain a ride yet.</string>
    <string name="loginsights_entry_open">Open tachograph</string>
    <plurals name="loginsights_entry_summary">
        <item quantity="one">%1$d ride over %2$s, last on %3$s</item>
        <item quantity="other">%1$d rides over %2$s in total, last on %3$s</item>
    </plurals>

    <!-- Archive -->
    <string name="loginsights_archive_title">Saved log</string>
    <plurals name="loginsights_archive_lines_unit">
        <item quantity="one">line</item>
        <item quantity="other">lines</item>
    </plurals>
    <plurals name="loginsights_archive_downloads">
        <item quantity="one">Merged from %d download</item>
        <item quantity="other">Merged from %d downloads</item>
    </plurals>
    <string name="loginsights_archive_span">From %1$s to %2$s, by the bike’s clock</string>
    <string name="loginsights_archive_empty">No measurement line is saved on this phone yet.</string>
    <string name="loginsights_archive_hint">Every download stays on the phone. YABA merges them, so rides the bike has already overwritten in its 128 KB memory are kept.</string>
    <string name="loginsights_archive_read">Read log now</string>
    <string name="loginsights_archive_read_again">Read again</string>
    <string name="loginsights_archive_reading">Reading the log …</string>
    <string name="loginsights_archive_reading_percent">Reading the log, %d%%</string>
    <string name="loginsights_archive_offline">The bike must be connected to read the log.</string>
    <string name="loginsights_archive_failed">The log did not arrive. Please stay near the bike and read it again.</string>
    <string name="loginsights_archive_partial">The last download ended before the end of the log. What arrived is saved.</string>

    <!-- Rides -->
    <string name="loginsights_rides_title">Rides</string>
    <plurals name="loginsights_rides_count">
        <item quantity="one">%d ride</item>
        <item quantity="other">%d rides</item>
    </plurals>
    <string name="loginsights_rides_none">The saved log contains no ride. A ride counts when the wheel turns in at least two measurement lines.</string>
    <string name="loginsights_rides_all">All rides</string>
    <string name="loginsights_rides_more">Show more rides</string>
    <string name="loginsights_ride_row">%1$s in %2$s, up to %3$s</string>
    <string name="loginsights_ride_sampling">The bike measures every 30\u00A0seconds. Peaks in between are missing, so the highest reading is usually below the true maximum.</string>
    <string name="loginsights_fact_distance">Distance</string>
    <string name="loginsights_fact_duration">Duration</string>
