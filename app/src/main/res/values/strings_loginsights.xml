    <string name="loginsights_fact_battery">Battery used</string>
    <string name="loginsights_fact_motor_temp">Motor peak</string>
    <string name="loginsights_fact_boost">With Boost</string>

    <!-- Charts -->
    <string name="loginsights_chart_scrub_hint">Drag across a chart, and the values at that moment appear under each chart.</string>
