    <string name="bikelab_alarm_stop">Arrêter l’alarme</string>
    <string name="bikelab_alarm_stop_note">Arrête une alarme en cours sans le code de secours. La commande efface aussi le verrou logiciel\u00A0; le vélo peut ensuite être considéré comme déverrouillé.</string>
    <string name="bikelab_selftest">Lancer l’autotest</string>
    <string name="bikelab_selftest_hint">Le vélo joue sa tonalité de diagnostic, écrit son état dans le journal, puis passe en veille. Le journal est enregistré d’abord.</string>
    <string name="bikelab_selftest_archiving">Enregistrement du journal …</string>
    <string name="bikelab_selftest_dialog_title">Lancer l’autotest</string>
    <string name="bikelab_selftest_dialog_text">Le vélo enregistre d’abord son journal, exécute ensuite le diagnostic et passe en veille. Le rapport évince les lignes les plus anciennes du journal\u00A0; c’est pourquoi l’enregistrement se fait d’abord.</string>
